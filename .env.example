# ─────────────────────────────────────────────────────────────
# GitRoasted environment configuration
# Copy this file to `.env.local` and fill in real values.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string used by the Mongoose connection helper.
MONGODB_URI=

# GitHub personal access token (classic or fine-grained, public read).
# Raises the GitHub REST API rate limit for the GitHub client.
GITHUB_TOKEN=

# ── AI providers (attempted in priority order) ──
# Primary provider to attempt first. One of: openrouter | gemini | openai | grok
AI_PRIMARY_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Grok / xAI
GROK_API_KEY=
GROK_MODEL=

# ── Caching & rate limiting ──
# Hours an existing roast is reused before regenerating (default 24).
CACHE_DURATION_HOURS=24

# Max AI-requiring roast requests allowed per IP per hour (default 5).
RATE_LIMIT_PER_HOUR=5

# ── App ──
# Public base URL used to build shareable result links, e.g. https://gitroasted.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
